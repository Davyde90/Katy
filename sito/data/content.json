    "faq": {
        "elenco": [
            {
                "domanda": "Quanto dura il semipermanente?",
                "risposta": "In media 2–3 settimane. Dipende dalle tue unghie e da quanto usi le mani: lavori in casa senza guanti e prodotti per pulire lo consumano prima."
            },
            {
                "domanda": "Il semipermanente rovina le unghie?",
                "risposta": "No, se viene messo e tolto nel modo giusto. Il danno arriva quando si strappa o si lima troppo: per questo la rimozione la faccio sempre io, con il prodotto apposito."
            },
            {
                "domanda": "Che differenza c'è tra semipermanente e gel?",
                "risposta": "Il semipermanente è uno smalto che si asciuga con la lampada: sottile, colora e protegge l'unghia naturale. Il gel è più spesso e resistente: serve per allungare (ricostruzione) o rinforzare le unghie fragili (copertura)."
            },
            {
                "domanda": "Posso portare la foto di un lavoro che mi piace?",
                "risposta": "Certo! Mandamela su WhatsApp quando prenoti: così ti dico tempi e prezzo e preparo i colori."
            },
            {
                "domanda": "E se non posso venire?",
                "risposta": "Avvisami almeno 24 ore prima, così posso dare il posto a un'altra cliente."
            }
        ]
    },
