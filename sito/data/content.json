    "faq": {
        "elenco": [
            {
                "domanda": "Che differenza c'è tra semipermanente e copertura in gel?",
                "risposta": "Il semipermanente è uno smalto che si asciuga con la lampada: colora e protegge l'unghia naturale. La copertura in gel è più spessa e resistente: rinforza le unghie fragili mantenendo la tua lunghezza, e si ritocca ogni 3–4 settimane."
            },
            {
                "domanda": "Ogni quanto va fatto il ritocco del gel?",
                "risposta": "Entro 4 settimane. Dopo, l'unghia è cresciuta troppo e serve più lavoro: per questo, se non dipende dal salone, c'è un supplemento da 5 €."
            },
            {
                "domanda": "Mi si è rotta un'unghia, cosa faccio?",
                "risposta": "Scrivimi: le riparazioni partono da 3 € a unghia. Se sono da sistemare 5 unghie o più, si paga il prezzo della copertura."
            },
            {
                "domanda": "Posso venire se le unghie me le ha fatte un'altra?",
                "risposta": "Certo. Prima però il lavoro va sistemato o tolto, quindi c'è un supplemento da 5 €."
            },
            {
                "domanda": "Il semipermanente rovina le unghie?",
                "risposta": "No, se viene messo e tolto nel modo giusto. Il danno arriva quando si strappa o si lima troppo: per questo la rimozione la faccio sempre io, con il prodotto apposito."
            },
            {
                "domanda": "Posso portare la foto di un lavoro che mi piace?",
                "risposta": "Certo! Mandamela su WhatsApp quando prenoti: così ti dico tempi e prezzo e preparo i colori."
            }
        ]
    },
